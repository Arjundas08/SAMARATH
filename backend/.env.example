# SAMARATH Environment Configuration Example
# Copy to .env for local runtime overrides

# Application
APP_ENV=development
APP_NAME=SAMARATH
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database
# Use postgresql+asyncpg for production PostgreSQL
# In local development without Postgres, falls back to sqlite+aiosqlite:///./samarath.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samarath
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/samarath

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demonstration Corridor
DEFAULT_CORRIDOR=VKC
TZ=Asia/Kolkata
