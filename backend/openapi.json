          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          },
          "is_authenticated": {
            "type": "boolean",
            "title": "Is Authenticated",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "username",
          "display_name",
          "roles",
          "permissions",
          "csrf_token"
        ],
        "title": "SessionResponse"
      },
      "Snapshot": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "corridor_code": {
            "type": "string",
            "title": "Corridor Code",
