{
  "openapi": "3.1.0",
  "info": {
    "title": "SAMARATH - Railway Block Planning API",
    "description": "System for Automated Maintenance Allocation, Rolling Availability, and Track Harmony (SIH26027)",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get System Health",
        "description": "Health check endpoint.\nDistinguishes a reachable FastAPI process from a functioning database connection.",
        "operationId": "get_system_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login",
        "description": "Authenticate user and set secure HttpOnly session cookie and CSRF cookie.\nNever exposes raw tokens in response body for localStorage.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout",
        "description": "Terminates session by clearing authentication and CSRF cookies.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get Session",
        "description": "Returns current authenticated session details.",
        "operationId": "get_session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create Task",
        "description": "Ingest and validate an engineering maintenance demand.\nEnforces total_block_minutes calculation and schema validation.",
        "operationId": "create_task_api_v1_tasks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshots": {
      "post": {
        "tags": [
          "Snapshots"
        ],
        "summary": "Create Snapshot",
        "description": "Creates and seals an immutable Snapshot container.\nComputes deterministic SHA-256 hash over canonical ordered entities.",
        "operationId": "create_snapshot_api_v1_snapshots_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshots/verify-hash": {
      "post": {
        "tags": [
          "Snapshots"
        ],
        "summary": "Verify Snapshot Hash",
        "description": "Verifies that the snapshot hash exactly matches the canonical computed digest.",
        "operationId": "verify_snapshot_hash_api_v1_snapshots_verify_hash_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/protected/plans/{plan_id}/approve": {
      "post": {
        "tags": [
          "RBAC Guards"
        ],
        "summary": "Approve Plan Action",
        "description": "Action requiring delegated operational programme approval authority.\nMust succeed for DELEGATED_APPROVER, and fail (403) for INFRASTRUCTURE_ADMIN and DEPARTMENT_PLANNER.",
        "operationId": "approve_plan_action_api_v1_protected_plans__plan_id__approve_post",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/protected/departments/{department}/demands": {
      "post": {
        "tags": [
          "RBAC Guards"
        ],
        "summary": "Create Departmental Demand",
        "description": "Action enforcing departmental isolation.",
        "operationId": "create_departmental_demand_api_v1_protected_departments__department__demands_post",
        "parameters": [
          {
            "name": "department",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DepartmentType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CriticalityTier": {
        "type": "string",
        "enum": [
          "TIER_1_MANDATORY",
          "TIER_2_SPEED_RESTRICTION",
          "TIER_3_CYCLIC"
        ],
        "title": "CriticalityTier"
      },
      "DatabaseHealth": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connected",
          "engine"
        ],
        "title": "DatabaseHealth"
      },
      "DemandStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "VALIDATED",
          "WITHDRAWN",
          "SUPERSEDED"
        ],
        "title": "DemandStatus"
      },
      "DepartmentType": {
        "type": "string",
        "enum": [
          "ENGINEERING",
          "SIGNALLING",
          "ELECTRICAL"
        ],
        "title": "DepartmentType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'healthy' or 'degraded'"
          },
          "app_name": {
            "type": "string",
            "title": "App Name",
            "default": "SAMARATH"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "process": {
            "type": "string",
            "title": "Process",
            "default": "reachable"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealth"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp Utc"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "LockedCommitment": {
        "properties": {
          "commitment_id": {
            "type": "string",
            "title": "Commitment Id"
          },
          "task_id": {
            "type": "string",
