          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "title": "Tasks"
          },
          "train_occupations": {
            "items": {
              "$ref": "#/components/schemas/TrainOccupation"
            },
            "type": "array",
            "title": "Train Occupations"
          },
          "resource_calendars": {
            "items": {
              "$ref": "#/components/schemas/ResourceCalendarEntry"
            },
            "type": "array",
            "title": "Resource Calendars"
          },
          "locked_commitments": {
            "items": {
              "$ref": "#/components/schemas/LockedCommitment"
            },
            "type": "array",
            "title": "Locked Commitments"
          },
          "snapshot_hash": {
            "type": "string",
            "title": "Snapshot Hash",
            "default": ""
          },
          "is_sealed": {
            "type": "boolean",
            "title": "Is Sealed",
            "default": true
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Created At Utc"
          },
          "created_by": {
            "type": "string",
            "title": "Created By",
            "default": "system"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "horizon_start_utc",
          "horizon_end_utc"
        ],
        "title": "Snapshot"
      },
      "Task": {
        "properties": {
          "business_key": {
            "type": "string",
            "title": "Business Key",
            "description": "Human-readable business key, e.g., TASK-TMS-0012"
          },
          "department": {
            "$ref": "#/components/schemas/DepartmentType"
          },
          "sub_department": {
            "type": "string",
            "title": "Sub Department"
          },
          "work_type": {
            "type": "string",
            "title": "Work Type"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "station_from": {
            "type": "string",
