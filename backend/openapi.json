          "horizon_start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Horizon Start Utc"
          },
          "horizon_end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Horizon End Utc"
          },
          "provenance_mode": {
            "$ref": "#/components/schemas/ProvenanceMode",
