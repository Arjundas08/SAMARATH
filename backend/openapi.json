          },
          "chainage_end_km": {
            "type": "number",
            "minimum": 0.0,
            "title": "Chainage End Km"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 15.0,
            "title": "Duration Minutes",
            "description": "Net physical productive work time in minutes"
          },
          "setup_buffer_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Setup Buffer Minutes",
            "description": "Pre-work possession and machine positioning buffer",
            "default": 30
          },
          "restoration_buffer_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Restoration Buffer Minutes",
            "description": "Post-work track testing and clearance buffer",
            "default": 30
          },
          "criticality": {
            "$ref": "#/components/schemas/CriticalityTier",
