            "default": false
          },
          "power_block_elementary_section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Block Elementary Section"
          },
          "requires_speed_restriction_after": {
            "type": "boolean",
            "title": "Requires Speed Restriction After",
            "default": false
          },
          "imposed_speed_kmh": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imposed Speed Kmh"
          },
          "provenance_mode": {
            "$ref": "#/components/schemas/ProvenanceMode",
            "default": "TEST"
          },
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          },
          "total_block_minutes": {
            "type": "integer",
            "title": "Total Block Minutes",
            "description": "Sum of duration + setup + restoration"
          },
          "demand_status": {
            "$ref": "#/components/schemas/DemandStatus",
            "default": "VALIDATED"
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Created At Utc"
          },
          "created_by": {
            "type": "string",
            "title": "Created By",
            "default": "system"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "business_key",
          "department",
          "sub_department",
          "work_type",
          "description",
          "station_from",
          "station_to",
          "track_segment_id",
          "chainage_start_km",
          "chainage_end_km",
          "duration_minutes",
          "deadline_utc",
          "total_block_minutes"
        ],
        "title": "Task"
      },
      "TaskCreate": {
        "properties": {
          "business_key": {
            "type": "string",
            "title": "Business Key",
            "description": "Human-readable business key, e.g., TASK-TMS-0012"
