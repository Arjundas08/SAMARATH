            "title": "Task Id"
          },
          "track_segment_id": {
            "type": "string",
            "title": "Track Segment Id"
          },
          "start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Start Utc"
          },
          "end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "End Utc"
          },
          "locked_by": {
            "type": "string",
            "title": "Locked By"
          },
          "lock_reason": {
            "type": "string",
            "title": "Lock Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "commitment_id",
          "task_id",
          "track_segment_id",
          "start_utc",
          "end_utc",
          "locked_by",
          "lock_reason"
        ],
        "title": "LockedCommitment"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "minLength": 4,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Permission": {
        "type": "string",
        "enum": [
          "DEMAND_READ",
          "DEMAND_CREATE",
          "DEMAND_MUTATE",
          "TIMETABLE_READ",
          "TIMETABLE_MUTATE",
          "SOLVE_TRIGGER",
          "PROGRAMME_REVIEW",
          "PROGRAMME_APPROVE",
          "RULE_EDIT",
          "RULE_APPROVE",
          "AUDIT_READ",
          "SYSTEM_ADMIN"
        ],
        "title": "Permission"
      },
      "PreferredWindow": {
        "properties": {
          "window_start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Window Start Utc"
          },
          "window_end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Window End Utc"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "window_start_utc",
          "window_end_utc"
        ],
        "title": "PreferredWindow"
      },
      "ProvenanceMode": {
        "type": "string",
        "enum": [
          "TEST",
          "SYNTHETIC_SCENARIO",
          "AUTHORIZED_IMPORT"
        ],
        "title": "ProvenanceMode"
      },
      "ResourceCalendarEntry": {
        "properties": {
          "entry_id": {
            "type": "string",
            "title": "Entry Id"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "resource_type": {
            "type": "string",
            "title": "Resource Type"
          },
          "available_start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Available Start Utc"
          },
          "available_end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Available End Utc"
          },
          "is_outage": {
            "type": "boolean",
            "title": "Is Outage",
            "default": false
          },
          "outage_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outage Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entry_id",
          "resource_id",
          "resource_type",
          "available_start_utc",
          "available_end_utc"
        ],
        "title": "ResourceCalendarEntry"
      },
      "ResourceRequirement": {
        "properties": {
          "resource_type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id",
            "description": "Unique machine ID or gang identifier"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resource_type",
          "resource_id"
        ],
        "title": "ResourceRequirement"
      },
      "ResourceType": {
        "type": "string",
        "enum": [
          "MACHINE",
          "CREW",
          "SPECIAL_EQUIPMENT"
        ],
        "title": "ResourceType"
      },
      "SessionResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/UserRole"
            },
            "type": "array",
            "title": "Roles"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "type": "array",
            "title": "Permissions"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "territory": {
            "type": "string",
            "title": "Territory",
