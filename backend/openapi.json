          },
          "deadline_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Deadline Utc"
          },
          "preferred_windows": {
            "items": {
              "$ref": "#/components/schemas/PreferredWindow"
            },
            "type": "array",
            "title": "Preferred Windows"
          },
          "required_resources": {
